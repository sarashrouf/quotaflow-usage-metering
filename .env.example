PORT=3000

# Local PostgreSQL connection for development and testing.
DATABASE_URL=postgresql://quota_app:CHANGE_ME@localhost:5433/quota_db

# PostgreSQL password used by Docker Compose.
POSTGRES_PASSWORD=CHANGE_ME

# Database connection inside the Docker network.
DOCKER_DATABASE_URL=postgresql://quota_app:CHANGE_ME@postgres:5432/quota_db

# Generate a unique random secret for administrator setup.
ADMIN_SETUP_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET