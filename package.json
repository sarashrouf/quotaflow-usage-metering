{
  "name": "usage-metering-service",
  "version": "1.0.0",
  "description": "Usage metering and quota management service",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:app": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "test": "npm run test:unit",
    "test:unit": "vitest run src/tests/quota-engine.test.ts",
    "test:integration": "vitest run src/tests/consumption.integration.test.ts src/tests/month-boundary.integration.test.ts --maxWorkers=1 --no-file-parallelism"
   },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "dotenv": "^18.0.8",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}